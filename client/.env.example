VITE_API_URL=https://your-backend-domain.com/api

# Upload large videos to Cloudinary or another CDN, then put the HTTPS URLs here.
# The local fallback files work for development, but AIBG-video.mp4 is too large for most frontend hosts.
VITE_LANDING_HERO_VIDEO_URL=https://res.cloudinary.com/YOUR_CLOUD/video/upload/path/landing-hero.mp4
VITE_STUDIO_BACKGROUND_VIDEO_URL=https://res.cloudinary.com/YOUR_CLOUD/video/upload/path/studio-background.mp4
